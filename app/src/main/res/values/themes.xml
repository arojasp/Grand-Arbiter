<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.GrandArbiter" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Splash: the icon's foreground (gavel + ring) alone on the app's navy. The ring fits the
         splash's visible circle (2/3 of the icon), so no icon background is needed. -->
    <style name="SplashTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenBackground">@color/brand_navy</item>
        <item name="postSplashScreenTheme">@style/Theme.GrandArbiter</item>
    </style>
</resources>
