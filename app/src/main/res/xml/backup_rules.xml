<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup up to Android 11. Back up the judge's own data (quick references and notes in
  judge_companion_db, settings) and skip what the app can rebuild: rules.db and cards.db are
  re-imported from the APK / downloaded again. cards.db alone can pass Auto Backup's 25 MB
  limit, and over the limit NOTHING is backed up, not even the quick references.
-->
<full-backup-content>
    <exclude domain="database" path="rules.db" />
    <exclude domain="database" path="rules.db-wal" />
    <exclude domain="database" path="rules.db-shm" />
    <exclude domain="database" path="cards.db" />
    <exclude domain="database" path="cards.db-wal" />
    <exclude domain="database" path="cards.db-shm" />
    <!-- A running judge call timer means nothing on another phone. -->
    <exclude domain="sharedpref" path="judge_call_timer.xml" />
</full-backup-content>
